generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Personal {
  id         String   @id @default(uuid())
  name       String
  title      String
  location   String
  relocation String
  email      String
  phone      String
  linkedin   String
  summary    String
  updatedAt  DateTime @updatedAt

  @@map("personal_profiles")
}

model Experience {
  id                  String   @id
  company             String
  role                String
  period              String
  location            String
  type                String
  architecturePattern String
  achievements        Json
  deliverables        Json
  techStack           Json
  order               Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("experiences")
}

model SkillCategory {
  id        String   @id @default(uuid())
  category  String   @unique
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())

  @@map("skill_categories")
}

model Skill {
  id         String        @id @default(uuid())
  name       String
  level      Int
  featured   Boolean       @default(false)
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([categoryId, name])
  @@map("skills")
}

model ArchitectureNode {
  id          String   @id
  title       String
  subtitle    String
  metric      String
  metricLabel String
  description String
  patterns    Json
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("architecture_nodes")
}

model Education {
  id          String   @id @default(uuid())
  degree      String
  institution String
  location    String
  period      String
  details     String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("education_records")
}

model Mobility {
  id         String   @id @default(uuid())
  status     String
  summary    String
  highlights Json
  checklist  Json
  updatedAt  DateTime @updatedAt

  @@map("mobility_passports")
}

model Language {
  id          String   @id @default(uuid())
  name        String   @unique
  proficiency String
  createdAt   DateTime @default(now())

  @@map("spoken_languages")
}

model Inquiry {
  id        String   @id @default(uuid())
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())

  @@map("contact_inquiries")
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admin_users")
}
